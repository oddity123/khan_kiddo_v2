# Khan Kiddo v2 环境变量模板
# 用法：cp .env.example .env 后填入真实值；.env 已在 .gitignore 中，切勿提交
#
# Spring Boot 不会自动读取 .env，启动前需手动 export，例如：
#   set -a && source .env && set +a
#   cd backend && ./mvn.sh spring-boot:run
# IDEA：Run Configuration → Environment variables → 从 .env 导入
#
# 宝塔面板：选「环境变量 → 从文件加载」指向本文件即可。
# 宝塔会把 KEY=value 注入 Java 进程环境，Spring 能读到，无需再 source。
# 格式请用纯 KEY=value（不要写 export 前缀）；生产务必 SPRING_PROFILES_ACTIVE=prod

# ===========================================
# JWT 认证（敏感，生产必填）
# ===========================================
# 至少 32 字符；前端通过 Authorization: Bearer <token> 访问受保护 API

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_HOURS=168

# ===========================================
# 服务
# ===========================================

# 后端端口（application.yml: server.port，默认 8080）
PORT=8080

# 网站备案信息（页脚展示，可选覆盖）
# APP_ICP_NUMBER=鄂ICP备2026025924号
# APP_ICP_URL=https://beian.miit.gov.cn/
# APP_PSB_NUMBER=鄂公网安备42010202002911号
# APP_PSB_URL=https://beian.mps.gov.cn/#/query/webSearch?code=42010202002911

# Spring Profile（dev / test / prod）
# 生产服务器务必设为 prod，以启用 application-prod.yml 并禁用开发默认值
SPRING_PROFILES_ACTIVE=dev

# ===========================================
# 数据库（敏感）
# ===========================================

DB_URL=jdbc:mysql://localhost:3306/khan_kiddo_dev?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-db-password-here

# ===========================================
# 豆包 / 火山方舟（app.llm doubao-seed、LangChain4j 默认 Bean）
# ===========================================
# 控制台：https://console.volcengine.com/ark

DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-doubao-api-key-here

# ===========================================
# 通义千问（app.llm qwen-plus）
# ===========================================
# 控制台：https://dashscope.console.aliyun.com/

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-dashscope-api-key-here

# 采样与请求限制（app.llm / LangChain4j 共用；Stage1 分离同用 temperature）
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=10240

# -------------------------------------------
# LLM 超时（三项含义不同，不要再用 AI_TIMEOUT_MS 一把梭）
# 时长写法与 Spring Duration 相同：45s / 5m / 60s
# -------------------------------------------
# HTTP 无数据读超时：socket 空闲多久断开。
# 流式场景下（语法助手等），对端只要还在吐 token 就不会触发；卡住不动才会断。
# 同时作用于 langchain4j.streaming-chat-model.timeout。
AI_HTTP_READ_TIMEOUT=45s
# 非流式单次调用超时：Stage1 分离、Stage2 语法分析、Stage3 总结各一次。
# 同时作用于 langchain4j.chat-model.timeout。
AI_CHAT_TIMEOUT=60s
# LangChain4j HTTP 层只打 1 次（不再 120s×3）。
# 分批失败再试一次由业务层负责，避免两层重试叠乘。
AI_MAX_RETRIES=1

# ===========================================
# 语法错句 RAG / Qdrant（可选；与 QWEN_API_KEY 同时配置后启用）
# ===========================================
# Java 客户端走 gRPC，端口默认 6334（6333 为 REST/Dashboard）
# 启动时会自动创建 collection（默认 grammar_errors，1024 维）

# QDRANT_HOST=your-qdrant-host
# QDRANT_PORT=6334
# QDRANT_API_KEY=
# QDRANT_GRAMMAR_COLLECTION=grammar_errors
# QDRANT_USE_TLS=false

# ===========================================
# ERRANT 操作批注（可选；Stage2 后软依赖）
# ===========================================
# 开启后对 original/suggestion 调用 ERRANT /v1/annotate，落库 R/M/U 编辑供前端高亮。
# 服务不可用时分析仍成功，仅无高亮。

# ERRANT_ENABLED=false
# ERRANT_BASE_URL=http://127.0.0.1:8000
# ERRANT_CONNECT_TIMEOUT=2s
# ERRANT_READ_TIMEOUT=10s

# ===========================================
# 日志（Spring Boot 3 兼容写法）
# ===========================================
# 勿使用 LOGGING_LEVEL=INFO — 会与 Spring Boot 3 绑定冲突导致启动失败
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_KHANKIDDO_LEARNING=DEBUG
