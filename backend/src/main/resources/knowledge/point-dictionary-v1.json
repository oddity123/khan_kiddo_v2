{
  "version": "v1-draft-2026-08-01-r2-runtime",
  "discriminators": [
    {
      "id": "ARTICLE_VS_PLURAL",
      "rule": "单复数本身错 → PLURAL_COUNTABLE / UNCOUNTABLE_NO_PLURAL；单复数正确、只是多了或少了冠词 → 冠词叶子"
    },
    {
      "id": "TENSE_VS_VERB_PATTERN",
      "rule": "选错时间（该过去却用现在等）→ FAM_TENSE；助动词/情态已经出现、后面动词形态错（did went / must to use）→ FAM_VERB_PATTERN"
    },
    {
      "id": "WORD_FORM_PRIORITY",
      "rule": "能命中 FEEL_ED_ADJ / GERUND_AS_SUBJECT / GERUND_AFTER_PREP 时优先细叶子；WORD_FORM_POS 仅用于其它词性错"
    },
    {
      "id": "STRUCTURE_OVERFLOW",
      "rule": "整句重写但说不清规则、或主要是卡壳/重复 → 不要硬打 STRUCTURE_*，改打 FLUENCY_* / LEXICAL_GAP / CHINESE_CODE_SWITCH"
    },
    {
      "id": "COLLOCATION_VS_PREP_VS_LEXICAL",
      "rule": "动词/名词固定短语（spoken English, do a role-play, look forward to）→ COLLOCATION；单纯 in/on/at 误用 → PREP_FIXED；一次性换词且无固定搭配 → LEXICAL_GAP"
    }
  ],
