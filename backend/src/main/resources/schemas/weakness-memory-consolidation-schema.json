{
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": ["CREATE", "MERGE", "SKIP"],
            "description": "CREATE=新建微习惯模式；MERGE=归并已有 memoryId；SKIP=本场该项不写入长期记忆"
          },
          "memoryId": {
            "type": ["integer", "null"],
            "description": "MERGE 时必填；CREATE/SKIP 可为 null"
          },
          "title": {
            "type": "string",
            "description": "单个病灶的微习惯标签：触发条件 + 可观察偏差（如 spend + 时间后漏 -ing）；一条 op 一个病灶，勿用分号粘合；禁止开口前教条；CREATE/MERGE 必填"
          },
          "anchorHabitKey": {
            "type": "string",
            "description": "关联 habitKey，可空"
          },
          "anchorPointId": {
            "type": "string",
            "description": "代表叶子 pointId，可空"
          }
        },
        "required": ["op"]
      }
    }
  },
  "required": ["operations"]
}
