{
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": ["CREATE", "MERGE", "SKIP"],
            "description": "CREATE=新建微习惯；MERGE=归并已有 memoryId；SKIP=本场该项不写入长期记忆"
          },
          "memoryId": {
            "type": ["integer", "null"],
            "description": "MERGE 时必填，对应输入 ACTIVE 记忆 id；CREATE/SKIP 可为 null"
          },
          "title": {
            "type": "string",
            "description": "具体微习惯短标题（CREATE/MERGE 必填）"
          },
          "diagnosis": {
            "type": "string",
            "description": "成因诊断（CREATE/MERGE 必填）"
          },
          "coaching": {
            "type": "string",
            "description": "开口前自检提示（CREATE/MERGE 必填）"
          },
          "anchorHabitKey": {
            "type": "string",
            "description": "关联 habitKey，可空"
          },
          "anchorPointId": {
            "type": "string",
            "description": "代表叶子 pointId，可空"
          },
          "badExample": {
            "type": "string",
            "description": "必须来自输入中的真实用户原句（CREATE/MERGE 必填）"
          },
          "targetRewrite": {
            "type": "string",
            "description": "对应自然改写（CREATE/MERGE 必填）"
          }
        },
        "required": ["op"]
      }
    }
  },
  "required": ["operations"]
}
