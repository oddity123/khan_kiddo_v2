        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["chinese", "expression"],
            "description": "chinese=中文词汇缺口；expression=英文 unnatural 短对立"
          },
          "index": {
            "type": "integer",
            "description": "与输入列表编号一致（从 1 开始）"
          },
          "front": {
            "type": "string",
            "minLength": 1,
            "description": "成长卡正面（chinese≈中文线索；expression≈中文题干/意图提示，不地道英文原文不进 front）；同场勿与已输出项近义重复；无法短对立时勿输出该条"
          },
          "back": {
            "type": "string",
            "minLength": 1,
            "description": "成长卡背面（chinese≈英文对应；expression≈地道表达）；同场勿近义重复"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "短中文说明：为何抽这个 / 学什么 / 为何这样改（每条保留项必填）"
          }
        },
        "required": [
          "kind",
          "index",
          "front",
          "back",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "可积累闪卡；跳过的 index 不出现；同场去重后的条目"
    }
  },
  "required": ["items"],
  "additionalProperties": false
