# 本机一键部署配置模板
# 用法：
#   cp deploy.env.example deploy.env
#   编辑 deploy.env，把所有 CHANGEME 改成真实值
#   ./deploy.sh
#
# deploy.env 已在 .gitignore，勿提交。
# 应用运行时环境变量（JWT/DB/API Key）请在宝塔「Java 项目 → 环境变量」配置，不在此文件。

# ---------- 必填 ----------

# SSH 连接
SSH_HOST=CHANGEME          # 服务器 IP 或域名，例：1.2.3.4
SSH_USER=root              # SSH 用户，宝塔多为 root
SSH_PORT=22                # SSH 端口

# 推荐：私钥免密登录（填写本机私钥路径）
# 若留空，则使用 ssh 默认配置（~/.ssh/config / ssh-agent）
SSH_KEY=                   # 例：~/.ssh/id_ed25519

# 宝塔 Java 项目名（与面板一致，供 java-service 使用）
BT_JAVA_PROJECT=CHANGEME   # 例：khankiddo-v2

# 服务器上 jar 所在目录与最终文件名（宝塔项目启动命令应对准该路径）
REMOTE_JAR_DIR=CHANGEME    # 例：/www/wwwroot/khankiddo-v2
REMOTE_JAR_NAME=khankiddo-v2.jar

# 前端静态站点目录（Nginx/宝塔站点根目录；会上传 dist.zip 并解压覆盖）
REMOTE_WEB_DIR=CHANGEME    # 例：/www/wwwroot/your-domain.com

# ---------- 可选 ----------

# 部署后健康检查（留空则跳过）
HEALTH_URL=                # 例：https://your-domain.com/api/health

# 上传方式：scp（默认，宝塔机通常无 rsync）或 rsync（需服务器也有 rsync）
UPLOAD_METHOD=scp
